<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>preview</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AnalysisLevel>latest</AnalysisLevel>
        <RootNamespace>TypedHttp</RootNamespace>
        <PolySharpIncludeRuntimeSupportedAttributes>true</PolySharpIncludeRuntimeSupportedAttributes>

        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynComponent>true</IsRoslynComponent>

        <!-- Enable package lockfiles -->
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

        <!-- Publish the repository URL in the built .nupkg (in the NuSpec <Repository> element) -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <RepositoryUrl>https://github.com/GGG-KILLER/TypedHttp.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryBranch>main</RepositoryBranch>
    </PropertyGroup>

    <!-- Package props -->
    <PropertyGroup>
        <!-- Allow packing -->
        <IsPackable>true</IsPackable>
        <IsPublishable>true</IsPublishable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>

        <!-- Package info -->
        <PackageId>TypedHttp</PackageId>
        <Authors>GGG</Authors>
        <Copyright>GGG © 2026</Copyright>
        <Version>0.2.0</Version>
        <Description>A strongly typed HTTP client source generator aiming for simplicity, zero extra runtime cost and ease of use. Similar to Refit, but implemented entirely with Roslyn source generators for maximal performance and full Ahead-of-Time (AOT) compilation compatibility.</Description>
        <PackageTags>http client;typed clients;http;rest</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/GGG-KILLER/TypedHttp</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

        <!-- Packaging settings -->
        <IncludeBuildOutput>false</IncludeBuildOutput>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="Resources/**"/>
        <EmbeddedResource Include="Resources/ClientAttributes.cs" Visible="true" LogicalName="ClientAttributes.cs"/>
        <EmbeddedResource Include="Resources/RequestAttributes.cs" Visible="true" LogicalName="RequestAttributes.cs"/>
        <EmbeddedResource Include="Resources/ParameterAttributes.cs" Visible="true" LogicalName="ParameterAttributes.cs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.Bcl.HashCode" PrivateAssets="all" GeneratePathProperty="true"/>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all"/>
        <PackageReference Include="PolySharp">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Tsu" PrivateAssets="all" GeneratePathProperty="true"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\TypedHttp.Common\TypedHttp.Common.csproj"/>
    </ItemGroup>

    <!-- Packaged Files -->
    <ItemGroup>
        <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
        <Content Include="$(PkgMicrosoft_Bcl_HashCode)/lib/netstandard2.0/Microsoft.Bcl.HashCode.dll" CopyToOutputDirectory="PreserveNewest" Link="Microsoft.Bcl.HashCode.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
        <Content Include="$(PkgTsu)/lib/netstandard2.0/Tsu.dll" CopyToOutputDirectory="PreserveNewest" Link="Tsu.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
        <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <!--
        When this generator is consumed via ProjectReference with OutputItemType="Analyzer"
        (the sample and the runtime integration tests), MSBuild forwards only this project's own
        assembly as an analyzer. Its dependencies (Tsu, Microsoft.Bcl.HashCode) must be forwarded
        too, otherwise the generator throws FileNotFoundException at generation time. NuGet-packaged
        consumers are handled separately by the analyzers/dotnet/cs entries above.
    -->
    <PropertyGroup>
        <GetTargetPathDependsOn>$(GetTargetPathDependsOn);GetGeneratorDependencyTargetPaths</GetTargetPathDependsOn>
    </PropertyGroup>
    <Target Name="GetGeneratorDependencyTargetPaths">
        <ItemGroup>
            <TargetPathWithTargetPlatformMoniker Include="$(PkgTsu)/lib/netstandard2.0/Tsu.dll" IncludeRuntimeDependency="false"/>
            <TargetPathWithTargetPlatformMoniker Include="$(PkgMicrosoft_Bcl_HashCode)/lib/netstandard2.0/Microsoft.Bcl.HashCode.dll" IncludeRuntimeDependency="false"/>
        </ItemGroup>
    </Target>

</Project>
